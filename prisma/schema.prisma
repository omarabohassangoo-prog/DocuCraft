// Multi-Tenant Hyperscale E-Commerce Platform - Prisma Schema (30 Tables)
// Matches Architecture Stage 2 & Diagram 02 (ERD)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique @db.VarChar(100)
  name             String   @db.VarChar(255)
  custom_domain    String?  @unique @db.VarChar(255)
  plan_tier        String   @default("enterprise") @db.VarChar(50)
  default_locale   String   @default("ar") @db.VarChar(10)
  default_currency String   @default("SAR") @db.VarChar(3)
  status           String   @default("active") @db.VarChar(30)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  users                  User[]
  roles                  Role[]
  sidebar_menus          SidebarMenu[]
  media_files            MediaFile[]
  cms_pages              CmsPage[]
  blog_posts             BlogPost[]
  contact_inquiries      ContactInquiry[]
  system_settings        SystemSetting[]
  encrypted_secrets      EncryptedSecret[]
  ad_units               AdUnit[]
  vendors                Vendor[]
  categories             Category[]
  products               Product[]
  carts                  Cart[]
  orders                 Order[]
  notification_templates NotificationTemplate[]
  notification_logs      NotificationLog[]
  audit_logs             AuditLog[]

  @@map("tenants")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  tenant_id             String    @db.Uuid
  email                 String    @db.VarChar(255)
  phone                 String?   @db.VarChar(30)
  password_hash         String    @db.Text
  full_name             String    @db.VarChar(200)
  avatar_file_id        String?   @db.Uuid
  user_type             String    @db.VarChar(30)
  email_verified_at     DateTime? @db.Timestamptz
  phone_verified_at     DateTime? @db.Timestamptz
  two_factor_enabled    Boolean   @default(false)
  two_factor_secret_enc String?   @db.Text
  preferred_locale      String    @default("ar") @db.VarChar(10)
  preferred_theme       String    @default("system") @db.VarChar(20)
  status                String    @default("active") @db.VarChar(30)
  last_login_at         DateTime? @db.Timestamptz
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @updatedAt @db.Timestamptz

  tenant            Tenant            @relation(fields: [tenant_id], references: [id])
  sessions          UserSession[]
  otp_verifications OtpVerification[]
  user_roles        UserRole[]        @relation("UserAssignedRoles")
  vendors           Vendor[]
  blog_posts        BlogPost[]
  carts             Cart[]
  orders            Order[]
  audit_logs        AuditLog[]

  @@unique([tenant_id, email])
  @@map("users")
}

model UserSession {
  id                 String    @id @default(uuid()) @db.Uuid
  tenant_id          String    @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique @db.VarChar(255)
  ip_address         String    @db.VarChar(45)
  user_agent         String    @db.Text
  expires_at         DateTime  @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, expires_at])
  @@map("user_sessions")
}

model OtpVerification {
  id          String    @id @default(uuid()) @db.Uuid
  tenant_id   String    @db.Uuid
  user_id     String?   @db.Uuid
  channel     String    @db.VarChar(20)
  purpose     String    @db.VarChar(40)
  target      String    @db.VarChar(255)
  code_hash   String    @db.VarChar(255)
  attempts    Int       @default(0)
  expires_at  DateTime  @db.Timestamptz
  verified_at DateTime? @db.Timestamptz
  created_at  DateTime  @default(now()) @db.Timestamptz

  user User? @relation(fields: [user_id], references: [id])

  @@map("otp_verifications")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  code        String   @db.VarChar(80)
  name_i18n   Json     @db.JsonB
  description String?  @db.Text
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz

  tenant           Tenant           @relation(fields: [tenant_id], references: [id])
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@unique([tenant_id, code])
  @@map("roles")
}

model Permission {
  id             String  @id @default(uuid()) @db.Uuid
  resource       String  @db.VarChar(100)
  action         String  @db.VarChar(50)
  code           String  @unique @db.VarChar(150)
  abac_condition Json?   @db.JsonB
  description    String? @db.Text

  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  granted_at    DateTime @default(now()) @db.Timestamptz

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@map("role_permissions")
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_by String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz

  user User @relation("UserAssignedRoles", fields: [user_id], references: [id])
  role Role @relation(fields: [role_id], references: [id])

  @@map("user_roles")
}

model SidebarMenu {
  id                  String  @id @default(uuid()) @db.Uuid
  tenant_id           String  @db.Uuid
  parent_id           String? @db.Uuid
  label_i18n          Json    @db.JsonB
  route_path          String  @db.VarChar(255)
  icon_name           String  @db.VarChar(80)
  required_permission String  @db.VarChar(150)
  dashboard_scope     String  @db.VarChar(40)
  sort_order          Int     @default(0)
  is_active           Boolean @default(true)

  tenant Tenant        @relation(fields: [tenant_id], references: [id])
  parent SidebarMenu?  @relation("SidebarNesting", fields: [parent_id], references: [id])
  items  SidebarMenu[] @relation("SidebarNesting")

  @@map("sidebar_menus")
}

model MediaFile {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  uploaded_by    String   @db.Uuid
  storage_driver String   @default("s3") @db.VarChar(20)
  bucket_name    String   @db.VarChar(120)
  object_key     String   @db.Text
  original_name  String   @db.VarChar(255)
  mime_type      String   @db.VarChar(100)
  size_bytes     BigInt
  width          Int?
  height         Int?
  variants_json  Json?    @db.JsonB
  is_public      Boolean  @default(true)
  alt_text_i18n  Json?    @db.JsonB
  created_at     DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("media_files")
}

model CmsPage {
  id                    String   @id @default(uuid()) @db.Uuid
  tenant_id             String   @db.Uuid
  page_key              String   @db.VarChar(80)
  slug                  String   @db.VarChar(160)
  title_i18n            Json     @db.JsonB
  meta_title_i18n       Json?    @db.JsonB
  meta_description_i18n Json?    @db.JsonB
  og_image_id           String?  @db.Uuid
  is_published          Boolean  @default(true)
  updated_by            String?  @db.Uuid
  updated_at            DateTime @updatedAt @db.Timestamptz

  tenant   Tenant       @relation(fields: [tenant_id], references: [id])
  sections CmsSection[]

  @@unique([tenant_id, slug])
  @@map("cms_pages")
}

model CmsSection {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  page_id      String   @db.Uuid
  section_type String   @db.VarChar(60)
  content_i18n Json     @db.JsonB
  media_id     String?  @db.Uuid
  sort_order   Int      @default(0)
  is_visible   Boolean  @default(true)
  updated_at   DateTime @updatedAt @db.Timestamptz

  page CmsPage @relation(fields: [page_id], references: [id])

  @@map("cms_sections")
}

model BlogPost {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  author_id      String    @db.Uuid
  slug           String    @db.VarChar(200)
  title_i18n     Json      @db.JsonB
  excerpt_i18n   Json?     @db.JsonB
  body_i18n      Json      @db.JsonB
  cover_image_id String?   @db.Uuid
  seo_tags       Json?     @db.JsonB
  status         String    @default("draft") @db.VarChar(30)
  published_at   DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  author User   @relation(fields: [author_id], references: [id])

  @@map("blog_posts")
}

model ContactInquiry {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  sender_name  String   @db.VarChar(150)
  sender_email String   @db.VarChar(255)
  sender_phone String?  @db.VarChar(30)
  subject      String   @db.VarChar(255)
  message      String   @db.Text
  status       String   @default("new") @db.VarChar(30)
  created_at   DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("contact_inquiries")
}

model SystemSetting {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  setting_group String   @db.VarChar(60)
  setting_key   String   @db.VarChar(120)
  setting_value Json     @db.JsonB
  is_public     Boolean  @default(false)
  updated_by    String?  @db.Uuid
  updated_at    DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, setting_group, setting_key])
  @@map("system_settings")
}

model EncryptedSecret {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  service_name   String    @db.VarChar(60)
  env_key        String    @unique @db.VarChar(120)
  ciphertext     String    @db.Text
  iv             String    @db.VarChar(64)
  auth_tag       String    @db.VarChar(64)
  key_version    Int       @default(1)
  last_synced_at DateTime? @db.Timestamptz
  updated_by     String    @db.Uuid
  updated_at     DateTime  @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("encrypted_secrets")
}

model AdUnit {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  name              String   @db.VarChar(120)
  adsense_client_id String   @db.VarChar(80)
  adsense_slot_id   String   @db.VarChar(80)
  placement         String   @db.VarChar(60)
  ad_format         String   @default("auto") @db.VarChar(40)
  is_active         Boolean  @default(false)
  updated_at        DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("ad_units")
}

model Vendor {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  owner_user_id     String   @db.Uuid
  store_slug        String   @db.VarChar(120)
  store_name_i18n   Json     @db.JsonB
  logo_file_id      String?  @db.Uuid
  commercial_reg_no String?  @db.VarChar(80)
  commission_rate   Decimal  @default(10.00) @db.Decimal(5, 2)
  kyc_status        String   @default("pending") @db.VarChar(30)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz

  tenant    Tenant           @relation(fields: [tenant_id], references: [id])
  owner     User             @relation(fields: [owner_user_id], references: [id])
  products  Product[]
  suborders VendorSuborder[]

  @@unique([tenant_id, store_slug])
  @@map("vendors")
}

model Category {
  id            String  @id @default(uuid()) @db.Uuid
  tenant_id     String  @db.Uuid
  parent_id     String? @db.Uuid
  slug          String  @db.VarChar(140)
  name_i18n     Json    @db.JsonB
  image_file_id String? @db.Uuid
  sort_order    Int     @default(0)
  is_active     Boolean @default(true)

  tenant   Tenant     @relation(fields: [tenant_id], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  tenant_id         String    @db.Uuid
  vendor_id         String    @db.Uuid
  category_id       String    @db.Uuid
  slug              String    @db.VarChar(200)
  title_i18n        Json      @db.JsonB
  description_i18n  Json      @db.JsonB
  primary_image_id  String?   @db.Uuid
  gallery_media_ids Json      @default("[]") @db.JsonB
  base_price        Decimal   @db.Decimal(12, 2)
  currency          String    @default("SAR") @db.VarChar(3)
  tax_rate          Decimal   @default(15.00) @db.Decimal(5, 2)
  seo_meta          Json?     @db.JsonB
  status            String    @default("draft") @db.VarChar(30)
  deleted_at        DateTime? @db.Timestamptz
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @updatedAt @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenant_id], references: [id])
  vendor   Vendor           @relation(fields: [vendor_id], references: [id])
  category Category         @relation(fields: [category_id], references: [id])
  variants ProductVariant[]

  @@index([tenant_id, status, category_id, created_at, id])
  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  product_id          String   @db.Uuid
  sku                 String   @db.VarChar(100)
  attributes          Json     @db.JsonB
  price               Decimal  @db.Decimal(12, 2)
  compare_at_price    Decimal? @db.Decimal(12, 2)
  stock_qty           Int      @default(0)
  reserved_qty        Int      @default(0)
  low_stock_threshold Int      @default(5)
  weight_grams        Int      @default(0)
  is_active           Boolean  @default(true)
  updated_at          DateTime @updatedAt @db.Timestamptz

  product     Product     @relation(fields: [product_id], references: [id])
  cart_items  CartItem[]
  order_items OrderItem[]

  @@unique([tenant_id, sku])
  @@map("product_variants")
}

model Cart {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  user_id     String?  @db.Uuid
  guest_token String?  @db.VarChar(120)
  currency    String   @default("SAR") @db.VarChar(3)
  expires_at  DateTime @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  tenant Tenant     @relation(fields: [tenant_id], references: [id])
  user   User?      @relation(fields: [user_id], references: [id])
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id                  String   @id @default(uuid()) @db.Uuid
  cart_id             String   @db.Uuid
  variant_id          String   @db.Uuid
  quantity            Int
  unit_price_snapshot Decimal  @db.Decimal(12, 2)
  added_at            DateTime @default(now()) @db.Timestamptz

  cart    Cart           @relation(fields: [cart_id], references: [id])
  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("cart_items")
}

model Order {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  customer_id      String   @db.Uuid
  order_number     String   @db.VarChar(40)
  subtotal_amount  Decimal  @db.Decimal(12, 2)
  tax_amount       Decimal  @db.Decimal(12, 2)
  shipping_amount  Decimal  @db.Decimal(12, 2)
  discount_amount  Decimal  @default(0) @db.Decimal(12, 2)
  grand_total      Decimal  @db.Decimal(12, 2)
  currency         String   @db.VarChar(3)
  shipping_address Json     @db.JsonB
  payment_status   String   @default("pending") @db.VarChar(30)
  order_status     String   @default("created") @db.VarChar(30)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  tenant               Tenant               @relation(fields: [tenant_id], references: [id])
  customer             User                 @relation(fields: [customer_id], references: [id])
  suborders            VendorSuborder[]
  payment_transactions PaymentTransaction[]

  @@unique([tenant_id, order_number])
  @@index([tenant_id, customer_id, created_at, id])
  @@map("orders")
}

model VendorSuborder {
  id                 String   @id @default(uuid()) @db.Uuid
  tenant_id          String   @db.Uuid
  order_id           String   @db.Uuid
  vendor_id          String   @db.Uuid
  suborder_number    String   @db.VarChar(45)
  gross_amount       Decimal  @db.Decimal(12, 2)
  commission_amount  Decimal  @db.Decimal(12, 2)
  vendor_net_amount  Decimal  @db.Decimal(12, 2)
  fulfillment_status String   @default("pending") @db.VarChar(30)
  tracking_number    String?  @db.VarChar(100)
  updated_at         DateTime @updatedAt @db.Timestamptz

  order  Order       @relation(fields: [order_id], references: [id])
  vendor Vendor      @relation(fields: [vendor_id], references: [id])
  items  OrderItem[]

  @@index([tenant_id, vendor_id, fulfillment_status, updated_at, id])
  @@map("vendor_suborders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  tenant_id      String  @db.Uuid
  suborder_id    String  @db.Uuid
  variant_id     String  @db.Uuid
  sku_snapshot   String  @db.VarChar(100)
  title_snapshot Json    @db.JsonB
  quantity       Int
  unit_price     Decimal @db.Decimal(12, 2)
  tax_amount     Decimal @db.Decimal(12, 2)
  line_total     Decimal @db.Decimal(12, 2)

  suborder VendorSuborder @relation(fields: [suborder_id], references: [id])
  variant  ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("order_items")
}

model PaymentTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  order_id        String   @db.Uuid
  gateway         String   @db.VarChar(30)
  gateway_tx_id   String?  @db.VarChar(180)
  idempotency_key String   @unique @db.VarChar(120)
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @db.VarChar(3)
  status          String   @db.VarChar(30)
  webhook_payload Json?    @db.JsonB
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  order Order @relation(fields: [order_id], references: [id])

  @@map("payment_transactions")
}

model NotificationTemplate {
  id                   String  @id @default(uuid()) @db.Uuid
  tenant_id            String  @db.Uuid
  event_code           String  @db.VarChar(80)
  channel              String  @db.VarChar(20)
  external_template_id String? @db.VarChar(120)
  subject_i18n         Json?   @db.JsonB
  body_i18n            Json    @db.JsonB
  is_active            Boolean @default(true)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("notification_templates")
}

model NotificationLog {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  user_id             String?   @db.Uuid
  channel             String    @db.VarChar(20)
  provider            String    @db.VarChar(30)
  recipient           String    @db.VarChar(255)
  provider_message_id String?   @db.VarChar(160)
  status              String    @db.VarChar(30)
  error_message       String?   @db.Text
  sent_at             DateTime? @db.Timestamptz
  created_at          DateTime  @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@map("notification_logs")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String   @db.VarChar(80)
  entity_type   String   @db.VarChar(80)
  entity_id     String?  @db.Uuid
  old_values    Json?    @db.JsonB
  new_values    Json?    @db.JsonB
  ip_address    String?  @db.VarChar(45)
  created_at    DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  actor  User?  @relation(fields: [actor_user_id], references: [id])

  @@index([tenant_id, created_at])
  @@map("audit_logs")
}
