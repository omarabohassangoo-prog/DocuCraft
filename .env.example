# ==============================================================================
# 1. Application & Runtime
# ==============================================================================
NODE_ENV="development"
APP_NAME="UfuqCommerce"
APP_URL="MY_APP_URL"
PORT=3000
DEFAULT_LOCALE="ar"
SUPPORTED_LOCALES="ar,en"

# ==============================================================================
# 2. PostgreSQL + Redis Cluster (Production Deployment)
# ==============================================================================
DATABASE_URL=""
DATABASE_READ_REPLICA_URL=""
REDIS_URL=""

# ==============================================================================
# 3. Auth, Sessions & AES-256-GCM Encryption
# ==============================================================================
AUTH_SECRET=""
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ENCRYPTION_MASTER_KEY=""
TOTP_ISSUER_NAME="UfuqCommerce"

# ==============================================================================
# 4. Email, SMS & WhatsApp Notifications
# ==============================================================================
EMAIL_PROVIDER="resend"
EMAIL_FROM_NAME="Ufuq Commerce"
EMAIL_FROM_ADDRESS="no-reply@ufuq.example.com"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

SMS_PRIMARY_PROVIDER="unifonic"
UNIFONIC_APP_SID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

WHATSAPP_API_VERSION="v19.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ==============================================================================
# 5. Payment Gateways (PayPal, Stripe, Mada / Tap)
# ==============================================================================
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

TAP_SECRET_KEY=""
TAP_WEBHOOK_SECRET=""

# ==============================================================================
# 6. Storage (S3 / R2) & Google Analytics / AdSense
# ==============================================================================
STORAGE_PROVIDER="local"
STORAGE_PUBLIC_BUCKET=""
STORAGE_PRIVATE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

GA4_MEASUREMENT_ID=""
GOOGLE_SEARCH_CONSOLE_VERIFICATION=""
ADSENSE_CLIENT_ID=""
